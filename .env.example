# Copy to .env and replace every placeholder. NEVER commit .env.
# Generate a JWT secret in PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})

# --- PostgreSQL (db container) ---
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=replace-with-a-db-password
POSTGRES_DB=warehouse

# --- Ports published on the host ---
WEB_PORT=8080
API_PORT=3000
DB_PORT=5432

# --- API ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# For local development outside Docker (API on host, DB in Docker, published on DB_PORT).
# Inside Compose, the api/migrate services build their own DATABASE_URL from POSTGRES_* with host "db".
DATABASE_URL=postgresql://warehouse:replace-with-a-db-password@localhost:5432/warehouse
# Test database. The database name MUST end with _test.
DATABASE_URL_TEST=postgresql://warehouse:replace-with-a-db-password@localhost:5432/warehouse_test

# --- Auth ---
# Minimum 32 characters.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
BCRYPT_COST=10
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Seed users (used by the migrate container; passwords min 8 chars) ---
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=replace-with-operator-password
SEED_OPERATOR_FULL_NAME=Warehouse Operator
SEED_SUPERVISOR_USERNAME=supervisor
SEED_SUPERVISOR_PASSWORD=replace-with-supervisor-password
SEED_SUPERVISOR_FULL_NAME=Warehouse Supervisor
# true = also create 5 sample products
SEED_SAMPLE_DATA=false
